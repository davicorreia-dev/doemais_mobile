# URL de conexão com o banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/doemais?schema=public"

# Chave secreta para assinatura dos tokens JWT (use uma string longa e complexa)
ACCESS_TOKEN_SECRET="sua_chave_secreta_jwt_aqui"

# Porta onde o servidor irá rodar
PORT=3000

# Ambiente de execução (development, production)
NODE_ENV="development"

# Origem permitida pelo CORS
CORS_ORIGIN="http://localhost:3001"
