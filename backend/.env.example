# URL de conexão com o banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/doemais?schema=public"

# Chave secreta para assinatura dos tokens JWT (longa e aleatória: openssl rand -hex 32). Nunca commitar.
ACCESS_TOKEN_SECRET="sua_chave_secreta_jwt_aqui"

# (opcional) Validade do access token: segundos (900) ou formato 15m / 1h / 7d. Padrão: 7d
# ACCESS_TOKEN_EXPIRATION_SECONDS=900
# (opcional) Validade do refresh token em dias. Padrão: 7
# REFRESH_TOKEN_EXPIRATION_DAYS=7

# Porta onde o servidor irá rodar
PORT=3000

# Ambiente de execução (development, production)
NODE_ENV="development"

# Origem(ns) extra(s) permitida(s) pelo CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:3001"

# (opcional) Base do link de redefinição de senha. Padrão: http://localhost:8081
# FRONTEND_URL="http://localhost:8081"
