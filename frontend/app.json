{
  "expo": {
    "name": "doemais",
    "slug": "doemais",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoDoe.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logoDoe.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "doemais",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoDoe.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.marreta_dev.doemais"
    },
    "web": {
      "favicon": "./assets/images/logoDoe.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "cae008fe-f0a1-430d-a031-fe4e7fca6625"
      }
    }
  }
}
